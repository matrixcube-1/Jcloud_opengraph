<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>opengraph</groupId>
  <artifactId>opengraph-jforex</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>opengraph-jforex</name>
  <description>Port Java/JForex du moteur d'arbitrage FX a chemins ouverts (reference Rust).</description>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
  </properties>

  <repositories>
    <repository>
      <id>dukascopy</id>
      <url>https://www.dukascopy.com/client/jforexlib/publicrepo/</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Fournie par la plateforme JForex a l'execution. -->
    <dependency>
      <groupId>com.dukascopy.api</groupId>
      <artifactId>JForex-API</artifactId>
      <version>2.13.99</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <!-- Jar de strategie deployable dans JForex (api en provided). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>og-jforex-strategy</finalName>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
